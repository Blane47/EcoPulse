# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so never put server secrets here.

# API base URL. On a physical phone use your PC's LAN IP (same Wi-Fi), e.g. http://192.168.1.20:5000/api
# Defaults to http://localhost:5000/api when unset (web, or USB phone with `adb reverse tcp:5000 tcp:5000`).
EXPO_PUBLIC_API_URL=

# Mapbox public token (pk.*) for the map screen
EXPO_PUBLIC_MAPBOX_TOKEN=
